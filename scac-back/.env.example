# process.env.PORT, process.env.REACT_APP_API_URL 로 사용하시면 됩니다


# scac-back
DB_URL=jdbc:mysql://db주소
DB_USERNAME=아이디
DB_PASSWORD=비밀번호
JWT_SECRET=여기에_충분히_긴_랜덤_문자열
TOSS_SECRET_KEY=토스_테스트_시크릿_키

# SOLAPI
SOLAPI_API_KEY=발급받은_API_KEY
SOLAPI_API_SECRET=발급받은_API_SECRET
# 해당 번호로 문자를 발송합니다
# 문자를 받는 사람은 계정에 저장되어있는 전화번호로 문자가 갑니다
SOLAPI_SENDER_NUMBER=휴대폰번호
# true로 해두면 입력한 폰번호으로 알림을 보냅니다. 문자 발송 담당자만 true해두면 됩니다
NOTIFICATION_ENABLED=false